# Canonical origin — used for sitemap.xml, robots.txt, canonical tags and OG URLs.
NEXT_PUBLIC_SITE_URL=https://shashank200801.vercel.app

# Contact form delivery (Resend — https://resend.com/api-keys).
# Without this the form returns a clear "email isn't configured" error instead of
# silently pretending to send.
RESEND_API_KEY=

# Optional overrides. Defaults: shashank200801@gmail.com and Resend's shared
# onboarding@resend.dev sender (works without verifying a domain).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
